class Solution {
public:
    int solve(int i, int j, int m, int n) {
        // Reached destination
        if (i == m - 1 && j == n - 1) {
            return 1;
        }
        // Out of the grid
        if (i >= m || j >= n) {
            return 0;
        }
        // Go Down
        int down = solve(i + 1, j, m, n);
        // Go Right
        int right = solve(i, j + 1, m, n);
        return down + right;
    }
    int uniquePaths(int m, int n) {
        return solve(0, 0, m, n);
    }
};
