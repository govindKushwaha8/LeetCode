class Solution {
public:
    string removeOuterParentheses(string s) {
        string ans = "";
        int balance = 0;

        for (char ch : s) {

            if (ch == '(') {
                // If balance > 0, this is NOT the outermost '('
                if (balance > 0) {
                    ans += ch;
                }
                balance++;
            }
            else {
                balance--;

                // If balance > 0, this is NOT the outermost ')'
                if (balance > 0) {
                    ans += ch;
                }
            }
        }

        return ans;
    }
};
