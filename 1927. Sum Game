class Solution {
public:
    bool sumGame(string num) {
        int n = num.size(), mid = n / 2;
        int diff = 0, leftQ = 0, rightQ = 0;

        for (int i = 0; i < mid; i++) {
            if (num[i] == '?') leftQ++;
            else diff += num[i] - '0';
        }

        for (int i = mid; i < n; i++) {
            if (num[i] == '?') rightQ++;
            else diff -= num[i] - '0';
        }

        int q = leftQ - rightQ;

        return diff * 2 + q * 9 != 0;
    }
};
