
class Solution {
public:
    int uniquePaths(vector<vector<int>>& grid) {
        const int MOD = 1e9 + 7;

        int m = grid.size();
        int n = grid[0].size();

        vector<vector<long long>> R(
            m, vector<long long>(n, 0)
        );

        vector<vector<long long>> D(
            m, vector<long long>(n, 0)
        );

        // Bottom-up DP
        for (int i = m - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {

                // Destination
                if (i == m - 1 && j == n - 1) {
                    R[i][j] = 1;
                    D[i][j] = 1;
                }

                // Mirror cell
                else if (grid[i][j] == 1) {

                    // Entered from right -> reflected down
                    if (i + 1 < m) {
                        R[i][j] = D[i + 1][j];
                    }

                    // Entered from down -> reflected right
                    if (j + 1 < n) {
                        D[i][j] = R[i][j + 1];
                    }
                }

                // Empty cell
                else {
                    long long ways = 0;

                    if (j + 1 < n) {
                        ways += R[i][j + 1];
                    }

                    if (i + 1 < m) {
                        ways += D[i + 1][j];
                    }

                    ways %= MOD;

                    R[i][j] = ways;
                    D[i][j] = ways;
                }
            }
        }

        return R[0][0];
    }
};
