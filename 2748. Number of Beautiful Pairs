class Solution {
public:
    int firstDigit(int x) {
        while (x >= 10)
            x /= 10;
        return x;
    }

    int countBeautifulPairs(vector<int>& nums) {
        int ans = 0;
        int n = nums.size();

        for (int i = 0; i < n; i++) {
            int first = firstDigit(nums[i]);

            for (int j = i + 1; j < n; j++) {
                int last = nums[j] % 10;

                if (__gcd(first, last) == 1)
                    ans++;
            }
        }

        return ans;
    }
};
